# ============================================================
# DevConnect – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file to version control.
# ============================================================


# ---------------------------
# App Configuration
# ---------------------------
VITE_APP_NAME=DevConnect
VITE_APP_URL=http://localhost:5173


# ---------------------------
# Backend API
# ---------------------------
# Base URL for your REST API backend
# Example: https://api.yourdomain.com/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1


# ---------------------------
# GitHub OAuth (Optional)
# ---------------------------
# Create OAuth App at: https://github.com/settings/developers
# Set callback URL to: http://localhost:5173/auth/github/callback
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here


# ---------------------------
# Google OAuth (Optional)
# ---------------------------
# Create OAuth credentials at: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here


# ---------------------------
# Real-time (Socket.io) (Optional)
# ---------------------------
# WebSocket server URL for real-time notifications and messages
VITE_SOCKET_URL=http://localhost:8000


# ---------------------------
# Image / File Storage (Optional)
# ---------------------------
# Cloudinary (for avatar and project image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset


# ---------------------------
# Analytics (Optional)
# ---------------------------
# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# ---------------------------
# Feature Flags (Optional)
# ---------------------------
# Set to "true" to enable, "false" to disable
VITE_ENABLE_REAL_TIME=false
VITE_ENABLE_GITHUB_OAUTH=false
VITE_ENABLE_GOOGLE_OAUTH=false
